# Digivideas Environment Variables — copy to .env.local and fill in real values.
# NEVER commit real secrets. Anything prefixed NEXT_PUBLIC_ is sent to the browser.

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel passcode (server-side only — never use a NEXT_PUBLIC_ prefix for it)
ADMIN_PASSCODE=
# Random string, at least 32 characters, used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Writable, persistent folder for CMS content, contact requests, analytics and leads.
# Defaults to ./data when empty. Back this folder up regularly.
DATA_DIR=

# Müşteri Bulucu (lead finder) works without any key: it opens Google Maps in a headless
# browser on the server (free). Install a browser once: pnpm exec playwright-core install --with-deps chromium
# Optional: path to an existing Chrome/Chromium executable instead of the downloaded one.
PLAYWRIGHT_CHROMIUM_PATH=

# Optional: Google Places API (New) key — official, more reliable alternative (paid above the free quota).
# Restrict it in Google Cloud Console to "Places API (New)" and to your server's IP.
GOOGLE_MAPS_API_KEY=

# Optional: Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=

# Optional: days to keep analytics data (default 400, minimum 30)
ANALYTICS_RETENTION_DAYS=

# Optional: set to 1 to disable automatic backups (on server start + daily)
BACKUP_DISABLED=

# --- Online ödeme (iyzico Checkout Form) ---
# iyzico panelinden: Ayarlar > Firma Ayarları > API anahtarları. Önce sandbox (test) anahtarlarıyla deneyin:
# https://sandbox-merchant.iyzipay.com  → test kartları: https://docs.iyzico.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# sandbox (test, varsayılan) veya live (gerçek çekim)
IYZICO_MODE=sandbox

# Optional: key used to encrypt stored secrets (SMTP password, payment-link tokens).
# Defaults to a key derived from ADMIN_SESSION_SECRET. If you change it, re-enter the SMTP password
# and create new payment links.
SETTINGS_ENCRYPTION_KEY=
