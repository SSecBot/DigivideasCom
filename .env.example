# Digivideas Environment Variables — copy to .env.local and fill in real values.
# NEVER commit real secrets. Anything prefixed NEXT_PUBLIC_ is sent to the browser.

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel passcode (server-side only — never use a NEXT_PUBLIC_ prefix for it)
ADMIN_PASSCODE=
# Random string, at least 32 characters, used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Writable, persistent folder for CMS content, contact requests, analytics and leads.
# Defaults to ./data when empty. Back this folder up regularly.
DATA_DIR=

# Google Places API (New) key for the admin "Müşteri Bulucu" (lead finder).
# Restrict it in Google Cloud Console to "Places API (New)" and to your server's IP.
GOOGLE_MAPS_API_KEY=

# Optional: Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=

# Optional: days to keep analytics data (default 400, minimum 30)
ANALYTICS_RETENTION_DAYS=
